
principle = 0
rate = 0
time = 0

while True:
    principle = float(input("Enter the principle amount: "))
    if principle < 0:
        print("Principle amount must be greater than 0. Enter again")
    else: 
        break

while rate <= 0 or rate > 100:
    rate = float(input("Enter the interest rate: "))
    if rate <= 0 or rate > 100:
        print("Interest rate must be greater than 0 and less than or equal to 100. Enter again")

while time <= 0:
    time = int(input("Enter the time(in years): "))
    if time <= 0:
        print("Time must be greater than 0. Enter again")

total = principle * pow((1 + (rate / 100)), time)
print(f"Balance after {time} years is ${total:,.2f}")