temp = float(input("Enter the temperature reading: "))
unit = input("Enter the unit in Celcius or Fahrenheit (C/F): ")

if unit == "C":
    result = (temp * 9/5) + 32
    unit = "F"
elif unit == "F":
    result = (temp - 32) * 5/9
    unit = "C"
else:
    print(f"Invalid unit")

print(f"The converted temperature is {round(result, 2)} {unit}")